Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"ODDS", " ", "POWER"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"F", "[", 
    RowBox[{"x_", ",", " ", "a_", ",", "b_", ",", "c_"}], "]"}], ":=", " ", 
   RowBox[{"Piecewise", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "^", "a"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"x", "^", "a"}], "  ", "+", " ", 
           RowBox[{"c", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", "x"}], ")"}], "^", "b"}]}]}], ")"}]}], ",", 
        " ", 
        RowBox[{"0", "  ", "<=", " ", "x", "  ", "<=", " ", "1"}]}], "}"}], 
      "}"}], ",", "0"}], "]"}]}]}]], "Input",
