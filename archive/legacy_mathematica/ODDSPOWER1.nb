              RowBox[{"lambda", "/", 
               RowBox[{"Abs", "[", "x", "]"}]}], ")"}], "^", "p"}]}], " ", 
           ",", " ", "2", ",", "2", ",", "2"}], "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{"Abs", "[", "x", "]"}], ">", "lambda"}]}], "}"}], "}"}], ",",
