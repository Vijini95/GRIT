Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", "BETA", " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"F", "[", 
     RowBox[{"x_", ",", " ", "a_", ",", " ", "b_"}], "]"}], ":=", " ", 
    RowBox[{"Piecewise", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{"BetaRegularized", "[", 
          RowBox[{"x", ",", "a", ",", "b"}], "]"}], ",", " ", 
         RowBox[{"0", "  ", "<=", " ", "x", "  ", "<=", " ", "1"}]}], "}"}], 
       "}"}], ",", "0"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"gate", " ", "parameters"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"aa", "=", " ", "1"}], ";", " ", 
    RowBox[{"bb", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"delta", "[", 
     RowBox[{"x_", ",", " ", "lambda_", ",", " ", "p_"}], "]"}], " ", ":=", 
    RowBox[{"Piecewise", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", " ", 
          RowBox[{"F", "[", 
           RowBox[{
            RowBox[{"1", "-", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"lambda", "/", 
                RowBox[{"Abs", "[", "x", "]"}]}], ")"}], "^", "p"}]}], " ", 
            ",", " ", "aa", ",", "bb"}], "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{"Abs", "[", "x", "]"}], ">", "lambda"}]}], "}"}], "}"}], 
      ",", "0"}], "]"}]}]}]}]], "Input",
