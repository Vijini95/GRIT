Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"TRUNCATED", " ", "LOGISTIC"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"F", "[", 
     RowBox[{"x_", ",", " ", "sigma_"}], "]"}], ":=", " ", 
    RowBox[{"Piecewise", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"1", "/", 
             RowBox[{"(", 
              RowBox[{"1", "+", 
               RowBox[{"Exp", "[", 
                RowBox[{
                 RowBox[{"-", "x"}], "/", "sigma"}], "]"}]}], ")"}]}], "-", 
            RowBox[{"1", "/", "2"}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"1", "/", 
             RowBox[{"(", 
              RowBox[{"1", "+", 
               RowBox[{"Exp", "[", 
                RowBox[{
                 RowBox[{"-", "1"}], "/", "sigma"}], "]"}]}], ")"}]}], "-", 
            RowBox[{"1", "/", "2"}]}], ")"}]}], ",", " ", 
         RowBox[{"0", "  ", "<=", " ", "x", "  ", "<=", " ", "1"}]}], "}"}], 
       "}"}], ",", "0"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"delta", "[", 
     RowBox[{"x_", ",", " ", "lambda_", ",", " ", "p_"}], "]"}], " ", ":=", 
    RowBox[{"Piecewise", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", " ", 
          RowBox[{"F", "[", 
           RowBox[{
            RowBox[{"1", "-", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"lambda", "/", 
                RowBox[{"Abs", "[", "x", "]"}]}], ")"}], "^", "p"}]}], " ", 
            ",", "2"}], "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{"Abs", "[", "x", "]"}], ">", "lambda"}]}], "}"}], "}"}], 
      ",", "0"}], "]"}]}]}]}]], "Input",
