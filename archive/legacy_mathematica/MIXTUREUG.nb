        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "eta"}], ")"}], " ", "x"}], "  ", "+", " ", 
         RowBox[{"eta", " ", 
          RowBox[{"x", "^", "gamma"}]}]}], ",", " ", 
        RowBox[{"0", "  ", "<=", " ", "x", "  ", "<=", " ", "1"}]}], "}"}], 
