Cell[BoxData[
 RowBox[{
  RowBox[{"Pprime", "[", 
   RowBox[{"\[Theta]_", ",", "\[Lambda]_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"2", " ", "\[Lambda]", " ", 
      RowBox[{"(", 
       RowBox[{"\[Theta]", "+", 
        RowBox[{"2", " ", "\[Lambda]"}], "+", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"\[Theta]", "^", "2"}], "+", 
          RowBox[{"4", " ", "\[Lambda]", " ", "\[Theta]"}]}], "]"}]}], 
       ")"}]}], "-", 
     RowBox[{"\[Lambda]", "^", "2"}]}], ")"}], "/", 
   RowBox[{"(", 
    RowBox[{"\[Theta]", "+", 
     RowBox[{"2", " ", "\[Lambda]"}], "+", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"\[Theta]", "^", "2"}], "+", 
       RowBox[{"4", " ", "\[Lambda]", " ", "\[Theta]"}]}], "]"}]}], 
    ")"}]}]}]], "Input",
