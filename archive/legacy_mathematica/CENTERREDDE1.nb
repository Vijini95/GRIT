Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{" ", 
    RowBox[{"DE", " ", "CENTERRED", " ", "at", " ", 
     RowBox[{"1", "/", "2"}]}], ")"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"DE", "[", 
     RowBox[{"x_", ",", "sigma_"}], "]"}], ":=", 
    RowBox[{"Piecewise", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"1", "/", "2"}], " ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "-", 
              RowBox[{"1", "/", "2"}]}], ")"}], "/", "sigma"}], "]"}]}], ",", 
         RowBox[{"x", "<=", 
          RowBox[{"1", "/", "2"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "-", 
          RowBox[{
           RowBox[{"1", "/", "2"}], " ", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"(", 
               RowBox[{"x", "-", 
                RowBox[{"1", "/", "2"}]}], ")"}]}], "/", "sigma"}], "]"}]}]}],
          ",", 
         RowBox[{"x", ">", 
          RowBox[{"1", "/", "2"}]}]}], "}"}]}], "}"}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"F", "[", 
     RowBox[{"x_", ",", " ", "sigma_"}], "]"}], ":=", " ", 
    RowBox[{"Piecewise", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"DE", "[", 
             RowBox[{"x", ",", "sigma"}], "]"}], "-", 
            RowBox[{"DE", "[", 
             RowBox[{"0", ",", "sigma"}], "]"}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"DE", "[", 
             RowBox[{"1", ",", "sigma"}], "]"}], "-", 
            RowBox[{"DE", "[", 
             RowBox[{"0", ",", "sigma"}], "]"}]}], ")"}]}], ",", " ", 
         RowBox[{"0", "  ", "<=", " ", "x", "  ", "<=", " ", "1"}]}], "}"}], 
       "}"}], ",", "0"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"delta", "[", 
     RowBox[{"x_", ",", " ", "lambda_", ",", " ", "p_"}], "]"}], " ", ":=", 
    RowBox[{"Piecewise", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", " ", 
          RowBox[{"F", "[", 
           RowBox[{
            RowBox[{"1", "-", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"lambda", "/", 
                RowBox[{"Abs", "[", "x", "]"}]}], ")"}], "^", "p"}]}], " ", 
            ",", 
            RowBox[{"1", "/", "2"}]}], "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{"Abs", "[", "x", "]"}], ">", "lambda"}]}], "}"}], "}"}], 
      ",", "0"}], "]"}]}]}]}]], "Input",
