     "TeXAssistantTemplate"]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"F", "[", 
     RowBox[{"x_", ",", " ", "a_"}], "]"}], ":=", " ", 
    RowBox[{"Piecewise", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Sin", "[", 
            RowBox[{"Pi", " ", 
             RowBox[{"x", "/", "2"}]}], "]"}], ")"}], "^", "a"}], ",", " ", 
         RowBox[{"0", "  ", "<=", " ", "x", "  ", "<=", " ", "1"}]}], "}"}], 
       "}"}], ",", "0"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"delta", "[", 
     RowBox[{"x_", ",", " ", "lambda_", ",", " ", "p_"}], "]"}], " ", ":=", 
    RowBox[{"Piecewise", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", " ", 
          RowBox[{"F", "[", 
           RowBox[{
            RowBox[{"1", "-", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"lambda", "/", 
                RowBox[{"Abs", "[", "x", "]"}]}], ")"}], "^", "p"}]}], " ", 
            ",", " ", "2"}], "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{"Abs", "[", "x", "]"}], ">", "lambda"}]}], "}"}], "}"}], 
      ",", "0"}], "]"}]}]}]}]], "Input",
