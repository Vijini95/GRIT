          RowBox[{"1", "-", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"lambda", "/", 
              RowBox[{"Abs", "[", "x", "]"}]}], ")"}], "^", "p"}]}], " ", 
          "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{"Abs", "[", "x", "]"}], ">", "lambda"}]}], "}"}], "}"}], ",",
